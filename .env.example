# Copy to .env. Never commit a real Hark cookie.
HARK2API_KEY=h2a_change_me
HARK2API_HOST=0.0.0.0
HARK2API_PORT=18611
HARK2API_COOKIE=
# Or keep the raw browser Cookie header in a separate local file.
HARK2API_COOKIE_FILE=
HARK2API_LOCALE=zh-CN
HARK2API_TIMEZONE=Asia/Shanghai
HARK2API_PUBLIC_BASE=
HARK2API_CHAT_TIMEOUT=300
HARK2API_TASK_QUEUE_LIMIT=8
# Optional persistent account/task files. Defaults are under data/.
HARK2API_ACCOUNTS_FILE=
HARK2API_TASKS_FILE=
